// Personal Coach — modelo de datos (F1).
// Decisiones y convenciones: docs/DATA_MODEL.md
// - Las columnas "enum" son String validadas por Zod (src/core/enums.ts), no enums nativos:
//   la fuente de verdad es src/core/enums.ts y cambiarlos no debe requerir migración.
// - localDate = String "YYYY-MM-DD" (día del usuario, timezone del perfil); DateTime UTC solo auditoría.
// - DB siempre en métrico (kg / cm / kcal).
// - Tablas de Coach AI pospuestas a la migración de Fase 6 (docs/AI_COACH.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============ PERFIL, OBJETIVO Y PREFERENCIAS ============

// ============ CUENTAS ============

/// Cuenta de acceso. La app es multi-usuario ligera y PRIVADA: las cuentas se
/// crean a mano con `pnpm user:create`, no hay registro público, ni email, ni
/// recuperación de contraseña, ni OAuth.
///
/// Relación 1:1 con UserProfile. Un usuario tiene como mucho un perfil, y el
/// perfil es la clave de aislamiento que ya usa todo el dominio: cada
/// comprobación de propiedad recorre hasta `TrainingProgram.profileId`. Con
/// 1:N habría que verificar además que el perfil es del usuario en cada una de
/// esas comprobaciones, duplicando la superficie de error sin aportar nada:
/// aquí una persona = un perfil.
model User {
  id           String   @id @default(cuid())
  /// Se compara en minúsculas; ver `normalizeUsername` en src/server/auth.
  username     String   @unique
  passwordHash String
  /// Desactivar una cuenta la deja fuera sin borrar su historial.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile UserProfile?
}

model UserProfile {
  id                String   @id @default(cuid())
  /// Dueño del perfil. Obligatorio y único: sin él no hay forma de saber de
  /// quién son los datos, y ese era el supuesto single-user que rompía el
  /// aislamiento.
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sex               String // enum Sex: MALE | FEMALE (usado para cálculos energéticos)
  birthDate         String // localDate
  heightCm          Float
  timezone          String   @default("Europe/Madrid")
  unitSystem        String   @default("METRIC") // enum UnitSystem
  // Contexto de actividad recogido en onboarding (inputs del TDEE inicial)
  dailySteps        Int?
  workActivity      String? // enum WorkActivity: SEDENTARY | LIGHT | MODERATE | HIGH
  sleepHoursTypical Float?
  trainingYears     Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  goals            Goal[]
  bodyMeasurements BodyMeasurement[]
  progressPhotos   ProgressPhoto[]
  dailyCheckIns    DailyCheckIn[]
  weeklyCheckIns   WeeklyCheckIn[]
  personalEvents   PersonalEvent[]
  trainingPrograms TrainingProgram[]
  nutritionTargets NutritionTarget[]
  nutritionLogs    NutritionLog[]
  recommendations  Recommendation[]
  preferences      UserPreference[]
  customExercises  Exercise[]
  exerciseNotes    ExerciseNote[]
}

model Goal {
  id             String      @id @default(cuid())
  profileId      String
  profile        UserProfile @relation(fields: [profileId], references: [id])
  strategy       String // enum GoalStrategy (intención elegida por el usuario)
  type           String // enum GoalType: comportamiento calórico interno derivado de strategy
  status         String      @default("ACTIVE") // enum GoalStatus: ACTIVE | COMPLETED | ABANDONED | SUPERSEDED
  /// Las filas de este modelo SON el historial de fases. Cambiar de estrategia
  /// (definición → volumen) cierra la fila activa y crea otra con `startDate`
  /// de hoy; corregir el peso objetivo o el ritmo edita la fila en sitio. La
  /// diferencia importa: `startDate` es lo que acota la tendencia corporal a
  /// la fase actual (`analysisStartLocalDate`).
  startDate      String // localDate
  startWeightKg  Float // peso al fijar el objetivo (para la traza)
  weeklyRatePct  Float // % del peso corporal / semana (negativo = pérdida)
  targetWeightKg Float?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([profileId, status])
}

/// Preferencias del onboarding (equipamiento, contraindicaciones, músculos
/// prioritarios...). Antes la clave era global, así que el segundo usuario en
/// completar el onboarding PISABA las del primero y todos leían las mismas
/// —contraindicaciones incluidas, que son un dato de salud—.
model UserPreference {
  id        String      @id @default(cuid())
  profileId String
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  updatedAt DateTime    @updatedAt

  @@unique([profileId, key])
  @@index([profileId])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ============ CUERPO Y CHECK-INS ============

/// FUENTE ÚNICA DE VERDAD del seguimiento corporal longitudinal: peso,
/// perímetros y % graso. Cualquier motor o pantalla que necesite "el peso" lo
/// lee de aquí y de ningún otro sitio (ver la nota de `DailyCheckIn.weightKg`).
///
/// UNA FILA POR PERSONA Y DÍA (`@@unique(profileId, localDate)`). La clave
/// natural es deliberada y tiene dos consecuencias:
///
///   · Registrar dos veces el mismo día NO crea un duplicado: la escritura es
///     siempre un `upsert` contra esa clave y la última medición del día gana.
///     Un pesaje no es un evento que haya que conservar: es el valor del día,
///     y quien se pesa dos veces normalmente está corrigiendo el primero.
///   · Como el cliente identifica la fila por FECHA y no por id, y el
///     `profileId` sale siempre de la sesión, la escritura no tiene superficie
///     IDOR. Solo el borrado necesita id, y ahí la guarda de propiedad es
///     obligatoria.
///
/// Todos los campos de medida son opcionales a propósito: el día que solo te
/// pesas es una fila con `weightKg` y nada más.
model BodyMeasurement {
  id                 String      @id @default(cuid())
  profileId          String
  profile            UserProfile @relation(fields: [profileId], references: [id])
  localDate          String
  weightKg           Float?
  waistCm            Float?
  /// Con cuántas tomas se midió `waistCm`: enum WaistProtocol
  /// (SINGLE | MEAN_OF_THREE). `null` = desconocido, y el motor lo trata como
  /// SINGLE. Cambia el umbral de lo que se puede afirmar (~5,4 cm con una
  /// toma, ~3,1 cm con la media de tres), así que no es metadato decorativo.
  waistProtocol      String?
  neckCm             Float?
  chestCm            Float?
  hipsCm             Float?
  bicepLeftCm        Float?
  bicepRightCm       Float?
  thighLeftCm        Float?
  thighRightCm       Float?
  calfCm             Float?
  /// % graso. SIEMPRE opcional y SIEMPRE una estimación: ni siquiera un DEXA
  /// es una medida directa. No se usa como cifra absoluta en ningún sitio.
  bodyFatPct         Float?
  /// De dónde sale ese %: enum BodyFatReliability (MEASURED | ESTIMATED).
  /// Sin él, dos lecturas no son comparables y el número no vale para nada.
  /// Obligatorio en la práctica cuando hay `bodyFatPct`; nulo si no lo hay.
  bodyFatReliability String?
  notes              String?
  createdAt          DateTime    @default(now())

  @@unique([profileId, localDate])
}

model ProgressPhoto {
  id        String      @id @default(cuid())
  profileId String
  profile   UserProfile @relation(fields: [profileId], references: [id])
  localDate String
  pose      String // enum PhotoPose: FRONT | SIDE | BACK
  filePath  String // relativo a data/photos/ — nunca binarios en DB
  notes     String?
  deletedAt DateTime?
  createdAt DateTime    @default(now())

  @@index([profileId, pose, localDate])
}

/// Check-in diario de NUTRICIÓN Y SENSACIONES (F4): kcal, proteína, pasos,
/// hambre, energía, sueño. Nada de esto vive en `BodyMeasurement`.
model DailyCheckIn {
  id         String      @id @default(cuid())
  profileId  String
  profile    UserProfile @relation(fields: [profileId], references: [id])
  localDate  String
  /// OBSOLETA — no la leas ni la escribas. El peso corporal vive en
  /// `BodyMeasurement.weightKg` y en ningún otro sitio.
  ///
  /// Las dos columnas nacieron en F1 con la misma clave `(profileId,
  /// localDate)` y ambas vacías. Con dos sitios donde cabe el peso del día,
  /// el motor de tendencia y el de nutrición acabarían leyendo números
  /// distintos para la misma fecha sin que nadie lo notara hasta que las
  /// cuentas no cuadraran.
  ///
  /// No se borra todavía porque la columna está vacía y quitarla es una
  /// migración destructiva que no arregla nada: la retirada real va cuando F4
  /// toque esta tabla de verdad.
  weightKg   Float?
  kcal       Int?
  proteinG   Int?
  steps      Int?
  hunger     Int? // 1..5
  energy     Int? // 1..5
  sleepHours Float?
  trained    Boolean?
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([profileId, localDate])
}

model WeeklyCheckIn {
  id                    String      @id @default(cuid())
  profileId             String
  profile               UserProfile @relation(fields: [profileId], references: [id])
  isoYear               Int
  isoWeek               Int
  weekStartDate         String // lunes, localDate
  avgWeightKg           Float?
  weightTrendKgPerWeek  Float?
  waistCm               Float?
  trainingAdherencePct  Float?
  nutritionAdherencePct Float?
  avgSleepHours         Float?
  fatigue               Int? // 1..5
  hunger                Int? // 1..5
  motivation            Int? // 1..5
  notes                 String?
  closedAt              DateTime?
  createdAt             DateTime    @default(now())

  @@unique([profileId, isoYear, isoWeek])
}

model PersonalEvent {
  id        String      @id @default(cuid())
  profileId String
  profile   UserProfile @relation(fields: [profileId], references: [id])
  localDate String
  endDate   String? // rangos (enfermedad, viaje)
  type      String // enum PersonalEventType (12 valores, src/core/enums.ts)
  note      String? // texto libre: dato NO confiable para la IA
  createdAt DateTime    @default(now())

  @@index([profileId, localDate])
}

// ============ CATÁLOGO ============

model MuscleGroup {
  id     String @id @default(cuid())
  code   String @unique // "DELT_LATERAL", "DORSAL", ... (seed fijo)
  nameEs String
  region String // enum BodyRegion: UPPER | LOWER | CORE

  contributions    ExerciseMuscleContribution[]
  recoveryCheckIns RecoveryCheckIn[]
}

/// Ejercicio del banco. Los del seed son GLOBALES (`profileId = null`) y los
/// ve todo el mundo; los que crea una persona son suyos y solo aparecen en su
/// biblioteca, su builder y su lista de sustitución.
///
/// `name` sigue siendo único GLOBALMENTE, no por perfil. Es deliberado: el
/// seed hace `upsert({ where: { name } })` y necesita esa unicidad, y con
/// `@@unique([profileId, name])` los globales quedarían sin restricción
/// (en Postgres NULL != NULL, así que dos "Press banca" globales colarían).
/// El precio es que dos personas no pueden llamar igual a sus ejercicios
/// custom; en una app privada de unas pocas cuentas es un precio aceptable, y
/// el servicio devuelve un error claro en vez de un fallo de constraint.
model Exercise {
  id              String       @id @default(cuid())
  name            String       @unique
  movementPattern String // enum MovementPattern
  systemicFatigue Int          @default(2) // 1..3 (coste sistémico aproximado)
  instructions    String?
  isCustom        Boolean      @default(false)
  isActive        Boolean      @default(true)
  /// Dueño, solo para ejercicios custom. `null` = catálogo global del seed.
  profileId       String?
  profile         UserProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())

  variants      ExerciseVariant[]
  contributions ExerciseMuscleContribution[]
  notes         ExerciseNote[]

  @@index([movementPattern])
  @@index([profileId])
}

/// Nota personal sobre un ejercicio: la señal técnica que cada uno se apunta
/// para sí ("piernas encogidas en el press banca", "no bloquear el codo").
///
/// Es de la PERSONA, no del ejercicio. `Exercise.instructions` es del catálogo
/// compartido y lo ve todo el mundo; esto es lo contrario: solo lo ve quien lo
/// escribe, y por eso vive en su propia tabla con `profileId` en vez de en una
/// columna de `Exercise`.
///
/// Cuelga del EJERCICIO (el movimiento), no de la variante: la señal es de
/// cómo ejecutas el movimiento, así que sigue apareciendo si pasas de barra a
/// mancuernas o si sustituyes en sesión dentro del mismo ejercicio. Una nota
/// por persona y ejercicio: se edita en sitio, no acumula historial —para lo
/// que pasó un día concreto ya están las notas de la sesión—.
model ExerciseNote {
  id         String      @id @default(cuid())
  profileId  String
  profile    UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  text       String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([profileId, exerciseId])
  @@index([exerciseId])
}

model ExerciseMuscleContribution {
  id            String      @id @default(cuid())
  exerciseId    String
  exercise      Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscleGroupId String
  muscleGroup   MuscleGroup @relation(fields: [muscleGroupId], references: [id])
  role          String // enum MuscleRole: PRIMARY | SECONDARY
  factor        Float // 0..1 — aproximación operativa para contar volumen, no fisiología medida

  @@unique([exerciseId, muscleGroupId])
  @@index([muscleGroupId])
}

model ExerciseVariant {
  id                 String    @id @default(cuid())
  exerciseId         String
  exercise           Exercise  @relation(fields: [exerciseId], references: [id])
  name               String // "Press inclinado — barra"
  equipment          String // enum Equipment
  loadStepKg         Float     @default(2.5) // incremento mínimo real de carga
  repRangeMin        Int       @default(8)
  repRangeMax        Int       @default(12)
  defaultRestSeconds Int       @default(120)
  contraindications  Json      @default("[]") // array de enum Contraindication
  isDefault          Boolean   @default(false)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())

  templateExercises TemplateExercise[]
  workoutExercises  WorkoutExercise[]
  setLogs           SetLog[]

  @@unique([exerciseId, name])
  @@index([equipment])
}

// ============ PROGRAMA ============

model TrainingProgram {
  id          String      @id @default(cuid())
  profileId   String
  profile     UserProfile @relation(fields: [profileId], references: [id])
  name        String
  daysPerWeek Int
  description String?
  isActive    Boolean     @default(true)
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())

  mesocycles Mesocycle[]

  @@index([profileId, isActive])
}

model Mesocycle {
  id           String          @id @default(cuid())
  programId    String
  program      TrainingProgram @relation(fields: [programId], references: [id])
  ordinal      Int
  status       String          @default("PLANNED") // enum MesocycleStatus: PLANNED | ACTIVE | COMPLETED | ABORTED
  weeksPlanned Int             @default(6)
  currentWeek  Int             @default(0) // 0 = no empezado
  startDate    String?
  endDate      String?
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  templates WorkoutTemplate[]
  sessions  WorkoutSession[]

  @@unique([programId, ordinal])
  @@index([status])
}

model WorkoutTemplate {
  id          String    @id @default(cuid())
  mesocycleId String
  mesocycle   Mesocycle @relation(fields: [mesocycleId], references: [id])
  name        String // "Día 1 — Torso A"
  ordinal     Int // orden dentro del microciclo semanal
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  exercises TemplateExercise[]
  sessions  WorkoutSession[]

  @@unique([mesocycleId, ordinal])
}

model TemplateExercise {
  id                String          @id @default(cuid())
  templateId        String
  template          WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exerciseVariantId String
  exerciseVariant   ExerciseVariant @relation(fields: [exerciseVariantId], references: [id])
  ordinal           Int
  baseSets          Int
  repRangeMin       Int
  repRangeMax       Int
  targetRir         Int             @default(2)
  restSeconds       Int             @default(120)
  notes             String?

  @@unique([templateId, ordinal])
  @@index([exerciseVariantId])
}

// ============ SESIONES Y LOGGING (operativo en F2; schema estable desde F1) ============
// Las sesiones NUNCA se hard-deletean desde la app (se marcan ABORTED/SKIPPED):
// la cascada WorkoutSession → WorkoutExercise → SetLog existe solo para
// correcciones deliberadas del usuario, y borra el historial a sabiendas.

model WorkoutSession {
  id                   String           @id @default(cuid())
  mesocycleId          String
  mesocycle            Mesocycle        @relation(fields: [mesocycleId], references: [id])
  templateId           String?
  template             WorkoutTemplate? @relation(fields: [templateId], references: [id])
  weekNumber           Int
  weekKind             String           @default("ACCUMULATION") // enum WeekKind: ACCUMULATION | DELOAD
  status               String           @default("PLANNED") // enum SessionStatus: PLANNED | IN_PROGRESS | COMPLETED | ABORTED | SKIPPED
  localDate            String
  startedAt            DateTime?
  finishedAt           DateTime?
  // Feedback post-sesión (chips 1..5)
  perceivedPerformance Int?
  pump                 Int?
  jointPain            Int?
  fatigue              Int?
  motivation           Int?
  notes                String?
  // Token de idempotencia del cierre: lo genera el cliente al pulsar "Guardar y
  // finalizar" y lo repite en cada reintento, para que una respuesta perdida no
  // se convierta en "tu valoración no se ha guardado" habiéndose guardado.
  // NULL = sesión cerrada antes de que existiera el token, o aún en curso.
  finishToken          String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  exercises        WorkoutExercise[]
  recoveryCheckIns RecoveryCheckIn[]

  @@index([mesocycleId, weekNumber])
  @@index([templateId])
  @@index([localDate])
  @@index([status])
}

model WorkoutExercise {
  id                String          @id @default(cuid())
  sessionId         String
  session           WorkoutSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseVariantId String
  exerciseVariant   ExerciseVariant @relation(fields: [exerciseVariantId], references: [id])
  ordinal           Int
  // SNAPSHOT de lo prescrito para ESTA sesión (editar la plantilla no reescribe historia)
  plannedSets       Int
  repRangeMin       Int
  repRangeMax       Int
  targetRir         Int
  restSeconds       Int
  notes             String?

  setLogs SetLog[]

  @@unique([sessionId, ordinal])
  @@index([exerciseVariantId])
}

model SetLog {
  id                String          @id @default(cuid())
  workoutExerciseId String
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  // Denormalizado: historial por variante en una sola query indexada
  exerciseVariantId String
  exerciseVariant   ExerciseVariant @relation(fields: [exerciseVariantId], references: [id])
  localDate         String
  setNumber         Int
  setType           String          @default("WORKING") // enum SetType: WARMUP | WORKING
  weightKg          Float
  reps              Int
  rir               Int?
  technique         Int? // 1..5
  completed         Boolean         @default(true)
  estimated1Rm      Float? // Epley con reps efectivas; calculado en escritura; solo si reps+rir <= 12
  notes             String?
  completedAt       DateTime        @default(now())

  @@unique([workoutExerciseId, setNumber])
  @@index([exerciseVariantId, localDate])
}

model RecoveryCheckIn {
  id            String         @id @default(cuid())
  sessionId     String
  session       WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  muscleGroupId String
  muscleGroup   MuscleGroup    @relation(fields: [muscleGroupId], references: [id])
  soreness      Int? // 1..5 (DOMS previo)
  jointPain     Int? // 1..5
  jointArea     String?
  createdAt     DateTime       @default(now())

  @@unique([sessionId, muscleGroupId])
  @@index([muscleGroupId, createdAt])
}

// ============ NUTRICIÓN (operativo en F4; target inicial desde onboarding F1) ============

model NutritionTarget {
  id               String          @id @default(cuid())
  profileId        String
  profile          UserProfile     @relation(fields: [profileId], references: [id])
  effectiveFrom    String // localDate; vigente hasta el siguiente target
  kcal             Int
  proteinG         Int
  carbsG           Int
  fatG             Int
  source           String // enum TargetSource: MANUAL | ALGORITHM | ONBOARDING
  recommendationId String?         @unique
  recommendation   Recommendation? @relation(fields: [recommendationId], references: [id])
  notes            String?
  createdAt        DateTime        @default(now())

  @@unique([profileId, effectiveFrom])
}

model MealTemplate {
  id        String    @id @default(cuid())
  name      String    @unique
  kcal      Int
  proteinG  Int
  carbsG    Int       @default(0)
  fatG      Int       @default(0)
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  logs NutritionLog[]
}

model NutritionLog {
  id             String        @id @default(cuid())
  profileId      String
  profile        UserProfile   @relation(fields: [profileId], references: [id])
  localDate      String
  description    String?
  mealTemplateId String?
  mealTemplate   MealTemplate? @relation(fields: [mealTemplateId], references: [id])
  // Snapshot: editar la plantilla no reescribe logs
  kcal           Int
  proteinG       Int           @default(0)
  carbsG         Int           @default(0)
  fatG           Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([profileId, localDate])
  @@index([mealTemplateId])
}

// ============ TRAZABILIDAD ============

model AlgorithmDecision {
  id               String   @id @default(cuid())
  engine           String // "program-generator" | "training" | "nutrition" | "recovery" | "safety" | "recommendation"
  algorithmVersion String
  ruleId           String
  inputSnapshot    Json // input completo del motor, congelado
  output           Json
  explanation      String
  evaluationDate   String // localDate que vio el motor
  createdAt        DateTime @default(now())

  recommendation Recommendation?

  @@index([engine, ruleId])
  @@index([evaluationDate])
}

model Recommendation {
  id                 String            @id @default(cuid())
  profileId          String
  profile            UserProfile       @relation(fields: [profileId], references: [id])
  decisionId         String            @unique // trazabilidad 1:1 obligatoria
  decision           AlgorithmDecision @relation(fields: [decisionId], references: [id])
  type               String // enum RecommendationType
  scope              String // enum RecommendationScope
  scopeId            String?
  priority           String            @default("MEDIUM") // enum Priority: LOW | MEDIUM | HIGH | CRITICAL
  status             String            @default("PENDING") // enum RecommendationStatus
  title              String
  body               String
  payload            Json?
  suppressedBy       String? // tipo de recomendación de mayor precedencia que la suprimió
  appliesToLocalDate String
  resolvedAt         DateTime?
  createdAt          DateTime          @default(now())

  nutritionTarget NutritionTarget? // 0..1: recommendationId es @unique

  @@index([profileId, status, priority])
  @@index([appliesToLocalDate])
}
