# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Build de producción que levantan los E2E offline (ver playwright.config.ts).
/.next-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# datos personales del usuario: base de datos, fotos y exportaciones. NUNCA en git.
/data/
/exports/
*.db
*.db-journal
*.db-wal
*.db-shm

# testing
/test-results/
/playwright-report/
/blob-report/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Scratch local de QA/depuración: nunca al repo (romperían `next build`).
tmp-*.ts
