# ── Base de datos (PostgreSQL) ────────────────────────────────────────────────
# SOLO server-side. Nunca prefijes esto con NEXT_PUBLIC_.
#
# Producción (Neon): usa la cadena CON POOLER (el host lleva "-pooler"), que es
# la que aguanta muchas conexiones efímeras de funciones serverless.
#   DATABASE_URL="postgresql://USUARIO:CONTRASENA@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
#
# Desarrollo local (Postgres de Homebrew). Ojo: Homebrew crea como
# superusuario tu usuario de macOS, no "postgres".
DATABASE_URL="postgresql://TU_USUARIO_MAC@localhost:5432/personal_coach_dev"

# Cadena DIRECTA de Neon (host SIN "-pooler"). Solo la necesitan las
# migraciones: `prisma migrate deploy` no funciona a través del pooler.
# En local no hace falta.
#
# Si usas la integración Neon-Vercel, NO hace falta ponerla: la integración
# inyecta `DATABASE_URL_UNPOOLED`, que prisma.config.ts también reconoce.
# DIRECT_DATABASE_URL="postgresql://USUARIO:CONTRASENA@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Servidor PostgreSQL local para los tests de integración. Solo se acepta
# localhost: los tests CREAN Y DESTRUYEN bases de datos y el helper aborta si
# apunta a un host remoto.
# TEST_DATABASE_URL="postgresql://localhost:5432/postgres"

# ── Acceso (usuario único) ────────────────────────────────────────────────────
# La app no tiene sistema de usuarios: es una puerta con una llave. Sin estas
# dos variables NADIE puede entrar (falla cerrado a propósito: una app mal
# configurada debe quedarse cerrada, no quedar abierta al mundo).
#
# Contraseña de acceso. Larga: es lo único que separa tu historial de Internet.
APP_PASSWORD=""
# Secreto para firmar la cookie de sesión. Mínimo 32 caracteres.
# Genérala con:  openssl rand -base64 32
# Rotarla cierra la sesión en todos los dispositivos.
AUTH_SECRET=""

# ── Coach AI (opcional) ───────────────────────────────────────────────────────
# Sin estas variables la app funciona igual: la sección Coach muestra
# "AI Coach no configurado" y el resto del tracker no se ve afectado.
# La clave vive SOLO en el servidor; nunca se envía al cliente ni se registra.
OPENAI_API_KEY=""
# Modelo por defecto: gpt-5.6-luna (generación actual más barata:
# 0,20 $/1M tokens de entrada, 1,20 $/1M de salida — precios oficiales
# verificados el 2026-08-25). Cambiar aquí no requiere tocar código.
AI_COACH_MODEL="gpt-5.6-luna"
# Topes de coste y tiempo. Los valores por defecto ya son razonables.
# AI_COACH_MAX_OUTPUT_TOKENS=700
# AI_COACH_MAX_CONTEXT_CHARS=24000
# AI_COACH_TIMEOUT_MS=25000
